rules_version = '2';
// Published to Firebase automatically when this changes (.github/workflows/publish-rules.yml).
// Without that set up: paste this whole file into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {

    // Cloud saves: only the owning account can read or write them.
    match /saves/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ratings + broken reports, split across shard docs s0..s15:
    //   { "z<gameId>": { v: { <uid>: 1 | -1 }, r: { <uid>: timestamp } }, last: { z, u } }
    // Everyone can read the totals. A signed-in user may only add, change or
    // remove their OWN vote/report, for one game per write.
    match /gameStats/{shard} {
      allow read: if true;
      allow create, update: if request.auth != null
        && shard.matches('s([0-9]|1[0-5])')
        && ((validStatsWrite() && !isBanned()) || isAdmin());
    }

    // Game submissions ("Submit a game"). A signed-in player can send one and
    // read or delete their own. Admins and mods can read all of them and change
    // status/note.
    match /submissions/{id} {
      allow create: if request.auth != null && !isBanned() && validSubmission(request.resource.data);
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isStaff());
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note'])
        && request.resource.data.status in ['pending', 'approved', 'added', 'rejected']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200));
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isStaff());
    }
    // Game admins. The site owner (ownerUid() below) is always an admin. Only
    // the owner can add or remove admins, and nobody can remove or suspend the
    // owner.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create: if isOwner() && loggedAs(uid, 'make_admin')
        && request.resource.data.keys().hasOnly(['name', 'addedBy', 'addedAt'])
        && shortText(request.resource.data.name, 40) && shortText(request.resource.data.addedBy, 40)
        && request.resource.data.addedAt == request.time;
      allow delete: if isOwner() && request.auth.uid != uid && loggedAs(uid, 'remove_admin');
    }

    // Mods: review reports, ideas and game submissions, and can look at the
    // account list (read-only). They can't suspend anyone, handle takedowns or
    // change roles. Admins add and remove them.
    match /mods/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create: if isAdmin() && loggedAs(uid, 'make_mod')
        && request.resource.data.keys().hasOnly(['name', 'addedBy', 'addedAt'])
        && shortText(request.resource.data.name, 40) && shortText(request.resource.data.addedBy, 40)
        && request.resource.data.addedAt == request.time;
      allow delete: if isAdmin() && loggedAs(uid, 'remove_mod');
    }

    // Suspended accounts: can still play and keep cloud saves, but can't
    // rate, report or submit. Only admins can add or remove these.
    match /bans/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create, update: if isAdmin() && request.auth.uid != uid && !isOwnerUid(uid) && loggedAs(uid, 'suspend')
        && request.resource.data.keys().hasOnly(['name', 'reason', 'by', 'at'])
        && shortText(request.resource.data.name, 40) && shortText(request.resource.data.reason, 200)
        && shortText(request.resource.data.by, 40) && request.resource.data.at == request.time;
      allow delete: if isAdmin() && loggedAs(uid, 'unsuspend');
    }

    // Action log. Every staff action writes an entry; admins can read them and
    // nobody can change or delete one from the site. Role and suspension
    // changes must be saved together with their entry: the same write also
    // updates auditLast/<account> to point at it, and the admins/mods/bans
    // rules above check that (loggedAs), so those changes can't skip the log.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && validLog(request.resource.data);
    }
    match /auditLast/{uid} {
      allow read: if isAdmin();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['action', 'by', 'at', 'logId'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.logId is string
        && getAfter(/databases/$(db)/documents/auditLog/$(request.resource.data.logId)).data.target == uid
        && getAfter(/databases/$(db)/documents/auditLog/$(request.resource.data.logId)).data.action == request.resource.data.action
        && getAfter(/databases/$(db)/documents/auditLog/$(request.resource.data.logId)).data.at == request.time;
    }

    // Small public-to-admins profile so admins can find accounts:
    // username (must match the sign-in name), join date, last visit.
    // Profile: username, joined, last seen, plus level, XP, badges, minutes
    // played, games tried and the game open now (shown in the Admin Panel)
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt', 'lastSeen', 'level', 'xp', 'badges', 'played', 'tried', 'playing'])
        && request.resource.data.username == request.auth.token.email.split('@')[0]
        && shortText(request.resource.data.createdAt, 40)
        && request.resource.data.lastSeen == request.time
        && optInt(request.resource.data, 'level', 0, 1000)
        && optInt(request.resource.data, 'xp', 0, 100000000)
        && optInt(request.resource.data, 'badges', 0, 500)
        && optInt(request.resource.data, 'played', 0, 100000000)
        && optInt(request.resource.data, 'tried', 0, 100000)
        && (!('playing' in request.resource.data) || (request.resource.data.playing is string && request.resource.data.playing.matches('[0-9]{0,7}')));
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // "People online now": each open tab writes { t: server time, s: site } to
    // presence/<random id> every couple of minutes. No account or personal
    // info; anyone can read it so the site and status page can count it.
    // Optional u: { "<YYYYMMDD>": { r, w } } is that browser's Firebase read and
    // write count for today, added up by the site to estimate daily usage.
    match /presence/{id} {
      allow read: if true;
      allow create, update: if id.matches('[A-Za-z0-9]{20}')
        && request.resource.data.keys().hasOnly(['t', 's', 'u', 'g'])
        && (!('g' in request.resource.data) || (request.resource.data.g is string && request.resource.data.g.matches('[0-9]{1,7}')))
        && request.resource.data.t == request.time
        && request.resource.data.s in ['gn2', 'light']
        && (!('u' in request.resource.data) || validUsage(request.resource.data.u));
    }
    // "N playing now" and "Top 10 this week" (js/live.js). Every 5 minutes one
    // browser adds up the presence heartbeats and saves the counts here.
    // Anyone can read them; they can only change every 2 minutes.
    match /live/now {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['at', 'online', 'games'])
        && request.resource.data.at == request.time
        && request.resource.data.online is int && request.resource.data.online >= 0 && request.resource.data.online <= 100000
        && request.resource.data.games is map && request.resource.data.games.size() <= 150
        && (resource == null || request.time > resource.data.at + duration.value(120, 's'));
    }
    match /live/{week} {
      allow read: if week.matches('w20[0-9]{4}');
      allow create, update: if week.matches('w20[0-9]{4}')
        && request.resource.data.keys().hasOnly(['at', 'p'])
        && request.resource.data.at == request.time
        && request.resource.data.p is map && request.resource.data.p.size() <= 3000
        && (resource == null || request.time > resource.data.at + duration.value(120, 's'));
    }
    function optInt(d, k, lo, hi) {
      return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }
    function validUsage(u) {
      return u is map && u.size() == 1
        && u.keys()[0].matches('20[0-9]{6}')
        && u.values()[0] is map
        && u.values()[0].keys().hasOnly(['r', 'w'])
        && u.values()[0].r is int && u.values()[0].r >= 0 && u.values()[0].r <= 100000
        && u.values()[0].w is int && u.values()[0].w >= 0 && u.values()[0].w <= 100000;
    }

    // Report a problem / Suggest a feature (js/feedback.js). The sender, mods
    // and admins can read a report. Approved ideas are readable by every
    // signed-in player, who can add or remove only their own vote.
    match /feedback/{id} {
      allow create: if request.auth != null && !isBanned() && validFeedback(request.resource.data);
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isStaff()
        || (resource.data.type == 'feature' && resource.data.status in ['approved', 'done']));
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['open', 'confirmed', 'fixed', 'approved', 'done', 'rejected']
        && (!('note' in request.resource.data) || shortText(request.resource.data.note, 200))
        && (!('reviewedBy' in request.resource.data) || shortText(request.resource.data.reviewedBy, 40))
        && (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == request.time);
      allow update: if request.auth != null && !isBanned()
        && resource.data.type == 'feature' && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('votes', {})) || request.resource.data.votes[request.auth.uid] == true);
      allow delete: if request.auth != null && ((resource.data.uid == request.auth.uid && resource.data.status == 'open') || isStaff());
    }
    // Automatic error reports (js/errors.js): one document per kind of error,
    // with a count and the details of the latest time it happened. Anyone can
    // add a new one or add one to an existing count; only admins can read them
    // or mark them resolved, and nobody else can change what's in them.
    match /errorLogs/{id} {
      allow read, delete: if isAdmin();
      allow create: if id.matches('e[a-z0-9]{6,30}')
        && request.resource.data.keys().hasOnly(['sig', 'source', 'message', 'where', 'gameId', 'gameName', 'count', 'firstAt', 'lastAt', 'last', 'status'])
        && id == 'e' + request.resource.data.sig
        && shortText(request.resource.data.source, 20) && shortText(request.resource.data.message, 200)
        && shortText(request.resource.data.where, 160) && shortText(request.resource.data.gameId, 12)
        && shortText(request.resource.data.gameName, 80)
        && request.resource.data.count == 1 && request.resource.data.status == 'open'
        && request.resource.data.firstAt == request.time && request.resource.data.lastAt == request.time
        && validErrorSample(request.resource.data.last);
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastAt', 'last', 'status'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.lastAt == request.time
          && request.resource.data.status == 'open'
          && validErrorSample(request.resource.data.last))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note'])
          && request.resource.data.status in ['open', 'resolved']
          && shortText(request.resource.data.get('note', ''), 200));
    }
    function validErrorSample(d) {
      return d is map && d.keys().hasOnly(['message', 'stack', 'detail', 'browser', 'ua', 'screen', 'memory', 'online', 'version', 'secondsOnPage', 'blockedSources', 'user', 'at'])
        && shortText(d.get('message', ''), 500) && shortText(d.get('stack', ''), 1500) && shortText(d.get('detail', ''), 500)
        && shortText(d.get('browser', ''), 60) && shortText(d.get('ua', ''), 300) && shortText(d.get('screen', ''), 30)
        && shortText(d.get('memory', ''), 10) && d.get('online', true) is bool && shortText(d.get('version', ''), 20)
        && d.get('secondsOnPage', 0) is int && shortText(d.get('blockedSources', ''), 120)
        && shortText(d.get('user', ''), 40) && shortText(d.get('at', ''), 30);
    }
    // Copyright takedown requests (js/takedown.js). Anyone can send one, no
    // account needed, since game owners usually won't have one. Only admins
    // (not mods) can read, review or delete them, since they hold contact info.
    match /takedowns/{id} {
      allow create: if validTakedown(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'reviewedBy', 'reviewedAt', 'gameId'])
        && request.resource.data.status in ['open', 'info', 'removed', 'rejected', 'restored']
        && shortText(request.resource.data.get('note', ''), 200)
        && shortText(request.resource.data.get('reviewedBy', ''), 40)
        && shortText(request.resource.data.gameId, 12);
    }
    function validTakedown(d) {
      return d.keys().hasOnly(['name', 'email', 'org', 'gameId', 'gameName', 'work', 'proof', 'details', 'statement', 'status', 'createdAt', 'uid'])
        && shortText(d.name, 80) && d.name.size() > 0
        && shortText(d.email, 120) && d.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && shortText(d.org, 120) && shortText(d.gameId, 12)
        && shortText(d.gameName, 80) && d.gameName.size() > 0
        && shortText(d.work, 300) && d.work.size() > 0
        && shortText(d.proof, 500) && d.proof.size() >= 10
        && shortText(d.details, 1000)
        && d.statement == true && d.status == 'open' && d.createdAt == request.time
        && (!('uid' in d) || (request.auth != null && d.uid == request.auth.uid));
    }
    // Games removed after a takedown: one public list (removals/games) every
    // visitor reads; only admins can change it.
    match /removals/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'games'
        && request.resource.data.keys().hasOnly(['ids', 'updatedAt', 'updatedBy'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 3000
        && request.resource.data.updatedAt == request.time
        && shortText(request.resource.data.updatedBy, 40);
    }
    function validFeedback(d) {
      return d.keys().hasOnly(['uid', 'username', 'type', 'category', 'title', 'details', 'gameId', 'gameName', 'context', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.status == 'open'
        && d.createdAt == request.time
        && d.type in ['bug', 'feature']
        && d.category in ['game', 'content', 'ads', 'site', 'account', 'other', 'idea']
        && shortText(d.title, 80) && d.title.size() > 0
        && shortText(d.details, 1000) && shortText(d.username, 40)
        && shortText(d.gameId, 12) && shortText(d.gameName, 80) && shortText(d.context, 200);
    }

    function isBanned() {
      return request.auth != null && exists(/databases/$(db)/documents/bans/$(request.auth.uid));
    }
    // The site owner's account ID. The site fills this in by itself when the
    // owner saves their GitHub token in the Owner Panel; then publish this file.
    function ownerUid() { return 'AKOZ92Fya7dXqNDcSFl8T6nLHwn2'; } // OWNER_UID
    function isOwnerUid(uid) { return ownerUid() != '' && uid == ownerUid(); }
    function isAdmin() {
      return request.auth != null && (isOwnerUid(request.auth.uid)
        || exists(/databases/$(db)/documents/admins/$(request.auth.uid)));
    }
    function isOwner() { return request.auth != null && isOwnerUid(request.auth.uid); }
    // Admins, or mods who aren't suspended
    function isStaff() {
      return isAdmin() || (request.auth != null && !isBanned()
        && exists(/databases/$(db)/documents/mods/$(request.auth.uid)));
    }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function validLog(d) {
      return d.keys().hasOnly(['action', 'target', 'targetName', 'by', 'byName', 'at', 'detail'])
        && d.by == request.auth.uid && d.at == request.time
        && d.action in ['suspend', 'unsuspend', 'make_mod', 'remove_mod', 'make_admin', 'remove_admin',
                        'remove_ratings', 'remove_rating', 'delete_submissions',
                        'make_trusted', 'remove_trusted', 'mark_fixed']
        && shortText(d.target, 128) && shortText(d.targetName, 40)
        && shortText(d.byName, 40) && shortText(d.detail, 200);
    }
    // True when this same write also logged `action` on account `uid`
    function loggedAs(uid, action) {
      let last = getAfter(/databases/$(db)/documents/auditLast/$(uid)).data;
      return last.action == action && last.by == request.auth.uid && last.at == request.time;
    }
    function validSubmission(d) {
      return d.keys().hasOnly(['uid', 'username', 'name', 'url', 'author', 'relation', 'license', 'genre', 'description', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.status == 'pending'
        && d.createdAt == request.time
        && shortText(d.name, 80) && d.name.size() > 0
        && shortText(d.url, 300) && d.url.matches('https?://.+')
        && shortText(d.author, 80) && d.author.size() > 0
        && d.relation in ['mine', 'permission', 'license']
        && shortText(d.username, 40) && shortText(d.license, 80)
        && shortText(d.genre, 40) && shortText(d.description, 500);
    }

    function validStatsWrite() {
      let uid = request.auth.uid;
      let after = request.resource.data;
      let before = resource == null ? {} : resource.data;
      let zk = after.last.z;
      return zk is string && zk.matches('z-?[0-9]{1,6}')
        && after.last.keys().hasOnly(['z', 'u']) && after.last.u == uid
        && after.diff(before).affectedKeys().hasOnly([zk, 'last'])
        && zoneEntryOk(before.get(zk, {}), after.get(zk, {}), uid);
    }

    function zoneEntryOk(b, a, uid) {
      let vChanged = a.get('v', {}).diff(b.get('v', {})).affectedKeys();
      let rChanged = a.get('r', {}).diff(b.get('r', {})).affectedKeys();
      // 'fixed' (when an admin marked the game fixed) can be there, but only admins change it
      return a.keys().hasOnly(['v', 'r', 'fixed']) && a.get('fixed', null) == b.get('fixed', null)
        && vChanged.hasOnly([uid]) && rChanged.hasOnly([uid])
        && (vChanged.size() == 0 || !(uid in a.get('v', {})) || a.v[uid] == 1 || a.v[uid] == -1)
        && (rChanged.size() == 0 || !(uid in a.get('r', {})) || a.r[uid] == request.time);
    }
  }
}
